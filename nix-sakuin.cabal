cabal-version: 2.4
name: nix-sakuin
version: 0.1.0.0
license: MIT
copyright: 2026 Meowcolm024
author: Meowcolm024
extra-source-files:
  LICENSE
  README.md
  test/assets/5a5lrqlgqqhfd02lp7l8gqdypcckxiqd.ls
  test/assets/5a5lrqlgqqhfd02lp7l8gqdypcckxiqd.narinfo
  test/assets/packages.json

common shared
  ghc-options:
    -Wall
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wunused-foralls
    -Wunused-imports
    -fprint-explicit-foralls
    -fprint-explicit-kinds
    -Werror

  default-extensions:
    ApplicativeDo
    DataKinds
    DerivingStrategies
    DerivingVia
    GADTs
    LambdaCase
    MultiWayIf
    NoStarIsType
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  build-depends:
    aeson >=2.2 && <3,
    base >=4 && <5,
    brotli,
    bytestring,
    containers,
    directory >=1.3 && <2,
    effectful >=2.6 && <3,
    hslogger >=1.3 && <2,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.5,
    http-types >=0.12 && <0.13,
    lzma,
    network-uri >=2.6 && <3,
    optparse-applicative >=0.18 && <0.19,
    path >=0.9 && <0.10,
    path-io >=1.8 && <2,
    random,
    regex-tdfa >=1.3 && <2,
    text >=2 && <3,
    typed-process,
    zstd,

  default-language: GHC2021

library
  import: shared
  hs-source-dirs: src
  exposed-modules:
    Sakuin
    Sakuin.Database
    Sakuin.Database.MemoryDatabase
    Sakuin.Hydra
    Sakuin.Log
    Sakuin.NixEnv
    Sakuin.Pipeline
    Sakuin.Progress
    Sakuin.Types
    Sakuin.WorkQueue

executable nix-sakuin
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    nix-sakuin

  autogen-modules:
    Paths_nix_sakuin

  other-modules:
    Cli
    Index
    Locate
    Paths_nix_sakuin

  ghc-options:
    -O2
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -funbox-strict-fields

test-suite nix-sakuin-test
  import: shared
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs:
    test

  other-modules:
    Sakuin.DatabaseSpec
    Sakuin.HydraSpec
    Sakuin.MockRegistry
    Sakuin.MockRegistrySpec
    Sakuin.NixEnvSpec
    Sakuin.PipelineSpec
    Sakuin.LogSpec
    Sakuin.TypesSpec

  build-depends:
    nix-sakuin,
    tasty,
    tasty-hunit,
